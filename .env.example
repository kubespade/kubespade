# macOS code signing + notarization for public DMG downloads.
# Copy to .env and fill in ( .env is gitignored ).
#
# 1. Apple Developer → Certificates → Developer ID Application (install in Keychain)
# 2. appleid.apple.com → App-Specific Passwords
# 3. developer.apple.com → Membership → Team ID

APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Optional — auto-detected from Keychain if omitted:
# CSC_NAME=Developer ID Application: Your Name (XXXXXXXXXX)

# Force unsigned ad-hoc builds even when MAC_RELEASE=1:
# SKIP_MAC_SIGN=1

# Loaded automatically for ./build-release.sh (MAC_RELEASE=1 → Developer ID + notarize).
# Plain ./build-mac.sh ignores these and uses ad-hoc sign.
# Windows Authenticode for public downloads (SmartScreen — like Gatekeeper on Mac):
# CSC_LINK=/path/to/codesign.pfx
# CSC_KEY_PASSWORD=your-pfx-password
# Or: WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD
# SKIP_WIN_SIGN=1  — unsigned (SmartScreen warns)

# Dev only — skip hard failures in ./build-release.sh:
# ALLOW_UNSIGNED_RELEASE=1
